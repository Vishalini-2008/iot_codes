#include <ESP32Servo.h>

Servo myServo;
int servoPin = 14;

void setup() {
  Serial.begin(115200);
  myServo.attach(servoPin);
  myServo.write(0);
  delay(1000);
}

void loop() {
  myServo.write(90);
  Serial.println("Moving to 90 degrees");
  delay(1500);

  myServo.write(0);
  Serial.println("...zero degrees");
  delay(1500);
}
