#include "WiFi.h"
void setup() {
    Serial.begin(115200);
    Serial.println("Initializing WiFi...");
    WiFi.mode(WIFI_STA);
}
void loop() {
    int n = WiFi.scanNetworks();
  
    if (n == 0) {
        Serial.println("no network found");
    }
    else {
        for (int i = 0; i < n; ++i) {
            Serial.println(WiFi.SSID(i));
        }

        Serial.println(".....");
    }
    delay(1000);
}
