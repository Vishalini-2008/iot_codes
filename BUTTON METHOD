// Arduino Blink Example
int ledpin=6;
int btnpin=7;
bool state=false;
void setup() {
  Serial.begin(9600);
  pinMode(ledpin, OUTPUT);
  pinMode(btnpin,INPUT_PULLUP);
}
void loop() {
  state=digitalRead(btnpin);
  if(state==LOW)
  {
    digitalWrite(6,HIGH);
    Serial.println("switched on");

  }
  else
  {
    digitalWrite(6,LOW);
    Serial.println("switched off!");
  }
  delay(1000);
}
